{
  "name": "nexausci",
  "version": "1.3.0",
  "license": "AGPL-3.0",
  "cloudflare": {
    "bindings": {
      "DATABASE_URL": {
        "description": "PostgreSQL connection string (Neon, Supabase, RDS, ...). Required for the app and for `db:setup` (migrations & admin seed)."
      },
      "AUTH_SECRET": {
        "description": "Random secret used to sign auth cookies."
      },
      "AUTH_SESSION_MAX_AGE": {
        "description": "Session lifetime in seconds (default 86400)."
      },
      "SEED_USER_EMAIL": {
        "description": "Email for the seeded admin user."
      },
      "SEED_USER_PASSWORD": {
        "description": "Password for the seeded admin user."
      },
      "SEED_USER_NAME": {
        "description": "Display name for the seeded admin user."
      }
    }
  },
  "scripts": {
    "dev": "prisma migrate deploy && prisma generate && next dev --webpack",
    "build": "next build --webpack",
    "vercel-build": "npm run db:setup && next build --webpack",
    "start": "prisma migrate deploy && prisma generate && next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p site/tsconfig.json --noEmit",
    "seed": "tsx scripts/seed-user.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:preflight": "node scripts/db-preflight.mjs",
    "db:setup": "tsx scripts/setup-db.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "npm run cf:build && npx wrangler deploy",
    "postinstall": "prisma generate",
    "cf:build": "npm run db:setup && CF_PAGES=1 opennextjs-cloudflare build",
    "cf:preview": "npm run db:setup && CF_PAGES=1 opennextjs-cloudflare build && CF_PAGES=1 opennextjs-cloudflare preview",
    "cf:deploy": "npm run db:setup && CF_PAGES=1 opennextjs-cloudflare build && CF_PAGES=1 opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "prisma": "^7.9.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "taepdf": "file:vendor/taepdf",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/qrcode-generator": "^0.0.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "wrangler": "^4.86.0"
  }
}
