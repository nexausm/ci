{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "nci",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding, the service name must match the worker name
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nci"
    }
  ],
  "vars": {
    "CF_PAGES": "1",
    // Non-secret runtime vars. Secrets (DATABASE_URL, AUTH_SECRET,
    // SEED_USER_PASSWORD) are prompted by the one-click deploy button via the
    // declarations in package.json + .env.example.
    "AUTH_SESSION_MAX_AGE": "86400",
    "SEED_USER_NAME": "John Doe"
  }
}
