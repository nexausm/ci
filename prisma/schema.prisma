generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  runtime                = "cloudflare"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ClientType {
  individual
  organization
}

enum CurrencyCode {
  BDT
  USD
}

enum InvoiceState {
  draft
  sent
}

model User {
  id           String   @id
  email        String   @unique
  name         String   @default("")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id           String     @id
  type         ClientType @default(individual)
  name         String     @default("")
  contactName  String     @default("")
  email        String     @default("")
  phone        String     @default("")
  addressLines String[]   @default([])
  notes        String     @default("")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Product {
  id                 String   @id
  name               String   @default("")
  description        String   @default("")
  basePriceUsd       Float    @default(0)
  basePriceBdt       Float    @default(0)
  discountedPriceUsd Float?
  discountedPriceBdt Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Invoice {
  id                String         @id
  invoiceNumber     String         @default("")
  invoiceDate       String         @default("")
  dueDate           String         @default("")
  currency          CurrencyCode   @default(BDT)
  clientId          String?
  billToType        ClientType     @default(individual)
  billToName        String         @default("")
  billToContactName String         @default("")
  billToAddress     String         @default("")
  billToPhone       String         @default("")
  billToEmail       String         @default("")
  items             Json           @default("[]")
  discountEnabled   Boolean        @default(false)
  discountValue     Float          @default(0)
  creditsEnabled    Boolean        @default(false)
  creditsValue      Float          @default(0)
  taxEnabled        Boolean        @default(false)
  taxLabel          String         @default("Tax")
  taxValue          Float          @default(0)
  adjustmentValue   Float          @default(0)
  notes             String         @default("")
  state             InvoiceState   @default(draft)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  payments          Payment[]
  externalCosts     ExternalCost[]
}

model Payment {
  id        String   @id
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date      String   @default("")
  amount    Float    @default(0)
  method    String   @default("Cash")
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExternalCost {
  id            String  @id
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId        String
  vendor        String  @default("")
  invoiceNumber String  @default("")
  billedDate    String  @default("")

  @@unique([invoiceId, itemId])
  @@index([invoiceId])
}
